@namespace EveContracts.App.Components

<aside class="detail">
    <div class="detail-hdr">
        <div class="top">
            <div>
                <div class="t">@Detail.Row.Title</div>
                <div class="sub">@Detail.Row.System · @Detail.Row.Station · expires @IskFormat.Expiry(Detail.Row.Expires, DateTime.UtcNow)</div>
            </div>
            <button class="close-btn" @onclick="OnClose">✕</button>
        </div>
        <div class="flag-row">
            @if (Detail.Row.Verdict == "BUY" && Detail.Terms.Type != "courier")
            {
                <span class="badge green">✓ PASSES ALL FILTERS</span>
            }
            @foreach (var flag in Detail.Row.Flags)
            {
                switch (flag)
                {
                    case "LOW_VOLUME_ITEM": <span class="badge amber">⚠ ITEM BELOW VOLUME FLOOR</span> break;
                    case "LOWSEC_PICKUP": <span class="badge red">⚠ LOWSEC PICKUP</span> break;
                    case "EXPIRES_SOON": <span class="badge amber">⏱ EXPIRES SOON</span> break;
                    case "SCAM_TITLE": <span class="badge red">⚑ SCAM PATTERN IN TITLE</span> break;
                    case "UNPRICED_ITEM": <span class="badge red">⚠ UNPRICED ITEM</span> break;
                    case "TOO_GOOD": <span class="badge red">⚑ TOO GOOD TO BE TRUE</span> break;
                    case "UNPRICED_REQUESTED": <span class="badge red">⚠ UNPRICED REQUESTED ITEMS</span> break;
                    case "RIGGED_HULL": <span class="badge amber">⚙ FITTED RIGS — SUNK COST</span> break;
                }
            }
        </div>
    </div>

    @if (ShowTerms)
    {
        var t = Detail.Terms;
        <div class="detail-sec">
            <div class="sec-lbl">Contract terms</div>
            <div class="ledger">
                <div class="line"><span>Type</span><span class="v">@TypeName(t.Type)</span></div>
                @if (t.Type == "courier")
                {
                    <div class="line"><span>Reward</span><span class="v">@IskFormat.Short(t.Reward)</span></div>
                    <div class="line"><span>Collateral</span><span class="v">@IskFormat.Short(t.Collateral)</span></div>
                    <div class="line"><span>Destination</span><span class="v">@(t.Destination == "" ? "—" : t.Destination)</span></div>
                }
                else
                {
                    <div class="line"><span>@(t.Type == "auction" ? "Starting bid" : "Price")</span><span class="v">@IskFormat.Short(t.Price)</span></div>
                    @if (t.Buyout > 0)
                    {
                        <div class="line"><span>Buyout</span><span class="v">@IskFormat.Short(t.Buyout)</span></div>
                    }
                }
                <div class="line"><span>Volume</span><span class="v">@t.VolumeM3.ToString("N0", Inv) m³</span></div>
                <div class="line"><span>Issued</span><span class="v">@t.Issued.ToLocalTime().ToString("yyyy-MM-dd HH:mm", Inv)</span></div>
                <div class="line"><span>Expires</span><span class="v">@IskFormat.Expiry(t.Expires, DateTime.UtcNow)</span></div>
            </div>
        </div>
    }

    @* Courier contracts have no public item list and no resale economics. *@
    @if (Detail.Terms.Type != "courier")
    {
    <div class="detail-sec">
        <div class="sec-lbl">Items vs Jita</div>
        @if (Detail.Items.Count == 0)
        {
            <div class="dimtxt mono" style="font-size:12px;">@(Detail.Terms.ItemsFetched ? "no items" : "items not fetched yet — next scan")</div>
        }
        <div class="items-tbl">
            <div class="items-grid items-head">
                <span>Item</span><span class="r">Jita sell</span><span class="r">Jita buy</span><span class="r">Vol/d</span>
            </div>
            @foreach (var it in Detail.Items)
            {
                <div class="items-grid items-row">
                    <div style="min-width:0;">
                        <div class="n">@(it.Included ? "" : "⇐ ")@it.Name</div>
                        <div class="q">×@it.Qty.ToString("N0", Inv) · @it.M3.ToString("N0", Inv) m³</div>
                    </div>
                    <div class="v">@IskFormat.Short(it.Sell)</div>
                    <div class="v dimtxt">@IskFormat.Short(it.Buy)</div>
                    <div class="v"><span class="@(it.BelowFloor ? "vol-low" : "")">@it.VolPerDay.ToString("N0", Inv)</span></div>
                </div>
            }
        </div>
    </div>

    <div class="detail-sec">
        <div class="sec-lbl">Profit breakdown@(ShowTerms && Detail.Terms.Verdict == "" ? " · outside scanner scope" : "")</div>
        <div class="ledger">
            <div class="line"><span>Jita sell value</span><span class="v">@IskFormat.Short(Detail.Row.SellVal)</span></div>
            <div class="line"><span>Contract price</span><span class="v">−@IskFormat.Short(Detail.Row.Price)</span></div>
            <div class="line"><span>Sales tax + broker (@FeePct.ToString("0.#", Inv)%)</span><span class="v">−@IskFormat.Short(Detail.Fees)</span></div>
            <div class="line"><span>Hauling @Detail.TotalM3.ToString("N0", Inv) m³ · @Detail.Row.Jumps jumps</span><span class="v">−@IskFormat.Short(Detail.Hauling)</span></div>
            <div class="rule"></div>
            <div class="total">
                <span>Net profit</span>
                <span class="v"><span class="@(Detail.Row.Profit > 0 ? "profit-pos" : "profit-neg")">@IskFormat.Signed(Detail.Row.Profit) (@((Detail.Row.Margin * 100).ToString("0.0", Inv))%)</span></span>
            </div>
            <div class="sub"><span>Est. time to liquidate</span><span class="v mono">@Detail.Liquidate</span></div>
        </div>
    </div>
    }
</aside>

@code {
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;
    [Parameter, EditorRequired] public ContractDetail Detail { get; set; } = null!;
    [Parameter] public double MinVolume { get; set; }
    [Parameter] public double FeePct { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>All Contracts view: show the raw contract terms (price/buyout/courier) above the items.</summary>
    [Parameter] public bool ShowTerms { get; set; }

    private static string TypeName(string t) => t switch
    {
        "item_exchange" => "Item Exchange",
        "auction" => "Auction",
        "courier" => "Courier",
        _ => t,
    };
}
