@namespace EveContracts.App.Components
@implements IDisposable
@inject UiState Ui
@inject SyncScheduler Scheduler
@inject ContractQueryService Query
@inject SettingsService Settings
@inject OwnContractSync OwnSync
@inject UpdateService Updater

<div class="shell">
    <header class="hdr">
        <div class="hdr-title">
            <span class="name">CONTRACT TRACKER</span>
            <span class="game">EVE ONLINE</span>
        </div>
        <nav>
            <button class="tab @(Ui.Tab == "scanner" ? "active" : "")" @onclick="@(() => SetTab("scanner"))">Profit Scanner</button>
            <button class="tab @(Ui.Tab == "own" ? "active" : "")" @onclick="@(() => SetTab("own"))">Our Contracts</button>
        </nav>
        <div class="hdr-right">
            @if (Updater.Status is "available" or "downloading" or "failed")
            {
                <button class="update-chip" disabled="@(Updater.Status == "downloading")" @onclick="ApplyUpdate">
                    @(Updater.Status switch
                    {
                        "downloading" => "updating…",
                        "failed" => "update failed — retry",
                        _ => $"⬆ v{Updater.AvailableVersion} available",
                    })
                </button>
            }
            <div class="esi-status">
                <span class="dot @StatusDotClass"></span>
                <span>ESI · @StatusText</span>
            </div>
            <div class="authed-chip">@_authedCount/@Math.Max(12, _charCount) characters authed</div>
            <button class="gear" title="Settings" @onclick="OpenSettings">⚙</button>
        </div>
    </header>

    @if (Ui.Tab == "scanner")
    {
        <ScannerView />
    }
    else
    {
        <OwnView />
    }

    @if (Ui.SettingsOpen)
    {
        <SettingsModal OnClosed="Refresh" />
    }
</div>

@code {
    private int _authedCount;
    private int _charCount;
    private System.Threading.Timer? _clock;

    protected override async Task OnInitializedAsync()
    {
        Ui.Changed += OnUiChanged;
        Scheduler.StatusChanged += OnUiChanged;
        OwnSync.Updated += OnCharsChanged;
        Updater.Changed += OnUiChanged;
        await LoadCharsAsync();
        // Tick every 30 s so "last scan Xm ago" stays honest.
        _clock = new System.Threading.Timer(_ => _ = InvokeAsync(StateHasChanged), null,
            TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task LoadCharsAsync()
    {
        var chars = await Query.GetCharactersAsync();
        _charCount = chars.Count;
        _authedCount = chars.Count(c => c.Authed);
    }

    // Filter clicks etc. only need a re-render; character counts change only on own-contract sync.
    private void OnUiChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnCharsChanged() => _ = InvokeAsync(async () =>
    {
        await LoadCharsAsync();
        StateHasChanged();
    });

    private void SetTab(string tab) { Ui.Tab = tab; Ui.Notify(); }

    private Task ApplyUpdate() => Updater.ApplyAsync();

    private void OpenSettings() { Ui.SettingsOpen = true; Ui.Notify(); }

    private async Task Refresh() { await LoadCharsAsync(); StateHasChanged(); }

    private string StatusDotClass => Scheduler.Status switch
    {
        "ready" => "ok",
        var s when s.StartsWith("startup failed") || s.StartsWith("sync error") => "bad",
        _ => "warn",
    };

    private string StatusText
    {
        get
        {
            if (Scheduler.Status != "ready") return Scheduler.Status;
            var last = Settings.LastPublicScan;
            if (last == DateTime.MinValue) return "no scan yet";
            var mins = (int)(DateTime.UtcNow - last).TotalMinutes;
            return mins < 1 ? "last scan just now" : $"last scan {mins}m ago";
        }
    }

    public void Dispose()
    {
        Ui.Changed -= OnUiChanged;
        Scheduler.StatusChanged -= OnUiChanged;
        OwnSync.Updated -= OnCharsChanged;
        Updater.Changed -= OnUiChanged;
        _clock?.Dispose();
    }
}
